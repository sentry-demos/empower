# Self-healing demo environment. Deploys flask to its own App Engine service:
#   GITHUB_SHA=$(git rev-parse HEAD) ./deploy flask --env=selfheal
# See selfheal/README.md. Shares the production database, Redis and Statsig.
SENTRY_ORG=demo
SENTRY_AUTH_TOKEN=${__ENV__}
GCP_PROJECT=sales-engineering-sf
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
DOMAIN=${__GCP_SECRET__}

DB_CLOUD_SQL_CONNECTION_NAME=${__GCP_SECRET__} # <project>:<region>:<instance>
DB_DATABASE=hardwarestore
DB_HOST=${__GCP_SECRET__}
DB_PASSWORD=${__GCP_SECRET__}
DB_USERNAME=${__GCP_SECRET__}

# Release is the commit SHA so "Fixes SELFHEAL-FLASK-N" resolves the issue in the release that ships the fix
GITHUB_SHA=${__ENV__}
FLASK_DSN=${__GCP_SECRET__(SELFHEAL_FLASK_DSN)}
FLASK_SENTRY_PROJECT=selfheal-flask
FLASK_APP_ENGINE_SERVICE=selfheal-flask
FLASK_ENVIRONMENT=selfheal
FLASK_REDISHOST=${__GCP_SECRET__(REDIS_SERVER_IP)}
FLASK_REDISPORT=6379
FLASK_RELEASE=selfheal-flask@${GITHUB_SHA}
STATSIG_SERVER_KEY=${__GCP_SECRET__}

RUBYONRAILS_SUBDOMAIN=ruby-on-rails
RUBYONRAILS_URL=https://${RUBYONRAILS_SUBDOMAIN}.${DOMAIN}
